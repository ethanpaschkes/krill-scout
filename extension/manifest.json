{
  "manifest_version": 3,
  "name": "Krill Scout",
  "version": "3.3.0",
  "description": "Free Krillion helper: 10 rare answers for every prompt from its own rarity model, an answer bank and Chrome's built-in AI.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://krillion.io/*",
        "https://playdaily.org/krillion*"
      ],
      "js": [
        "results.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://krillion.io/*",
        "https://playdaily.org/krillion*"
      ],
      "js": [
        "model.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/freq.txt",
        "data/dict.txt",
        "data/krillion.json",
        "data/topics.json"
      ],
      "matches": [
        "https://krillion.io/*",
        "https://playdaily.org/*"
      ]
    }
  ]
}
